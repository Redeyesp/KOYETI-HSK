{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KOYETI HSK lesson file",
  "description": "Schema for assets/database/lessons/*.json and the merged hanzi_database.json.",
  "type": "object",
  "required": [
    "metadata",
    "cards"
  ],
  "properties": {
    "metadata": {
      "type": "object"
    },
    "card_count": {
      "type": "integer"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "unicode",
          "character",
          "hsk",
          "stroke_count",
          "frequency",
          "tags",
          "pinyin",
          "meaning",
          "vocabulary",
          "notes"
        ],
        "properties": {
          "unicode": {
            "type": "string",
            "pattern": "^[0-9A-F]{4,6}$"
          },
          "character": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1
          },
          "hsk": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          },
          "stroke_count": {
            "type": "integer",
            "minimum": 1
          },
          "frequency": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pinyin": {
            "description": "Readings with tone marks, most relevant first.",
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "meaning": {
            "$ref": "#/$defs/meaning"
          },
          "vocabulary": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/vocabulary"
            }
          },
          "notes": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "meaning": {
      "type": "object",
      "required": [
        "en",
        "th"
      ],
      "properties": {
        "en": {
          "description": "Plain ASCII only: the device draws English with the U8g2 6x12 font.",
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "th": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    },
    "vocabulary": {
      "type": "object",
      "required": [
        "word",
        "pinyin",
        "hsk",
        "meaning"
      ],
      "properties": {
        "word": {
          "type": "string",
          "minLength": 1
        },
        "pinyin": {
          "type": "string",
          "minLength": 1
        },
        "hsk": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9
        },
        "meaning": {
          "$ref": "#/$defs/meaning"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
